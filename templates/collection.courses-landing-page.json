    "faq_anQkzn": {
      "type": "faq",
      "blocks": {
        "question_nyCaeX": {
          "type": "question",
          "settings": {
            "title": "What software does this course teach?",
            "text": "<p>This course is <strong>strictly focused on Adobe After Effects<\/strong>. It covers everything from the fundamentals to advanced motion graphics, VFX, speed ramping, keyframe animation, and professional editing techniques.<\/p>"
          }
        },
        "question_TqTjjJ": {
          "type": "question",
          "settings": {
            "title": "Do I need experience to take this course?",
            "text": "<p>No. This course is designed for <strong>all skill levels<\/strong>, whether you're completely new to Adobe After Effects or already have some experience and want to improve. Lessons are structured <strong>step by step<\/strong>, making it easy to follow along, even if you’ve never opened the software before.<\/p>"
          }
        },
        "question_M7XGLP": {
          "type": "question",
