          "settings": {
            "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Responsive Interactive Image Cards<\/title>\n    \n    <!-- Google Font (Baloo) -->\n    <link href=\"https:\/\/fonts.googleapis.com\/css2?family=Baloo+2:wght@400;700&display=swap\" rel=\"stylesheet\">\n    \n    <!-- Basic CSS -->\n    <style>\n        \/* Global Styles *\/\n        body {\n            font-family: 'Baloo 2', sans-serif;\n            margin: 0;\n            padding: 0;\n            background-color: #f0ede0; \/* Cream background color *\/\n            color: #333;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            min-height: 100vh;\n        }\n\n        \/* Header with rainbow color shift effect *\/\n        h1 {\n            font-size: 2.5rem;\n            color: transparent; \/* Make text transparent for background-clip effect *\/\n            text-align: center;\n            background: linear-gradient(90deg, rgba(255, 102, 102, 0.6), rgba(255, 178, 102, 0.6), rgba(255, 255, 153, 0.6), rgba(153, 255, 153, 0.6), rgba(153, 204, 255, 0.6), rgba(204, 153, 255, 0.6), rgba(255, 153, 204, 0.6));\n            background-size: 300%;\n            -webkit-background-clip: text;\n            background-clip: text;\n            color: transparent;\n            animation: colorWipe 10s linear infinite;\n            transition: 0.3s ease;\n        }\n\n        \/* Animation for the color shift *\/\n        @keyframes colorWipe {\n            0% {\n                background-position: 0%;\n            }\n            50% {\n                background-position: 100%;\n            }\n            100% {\n                background-position: 0%;\n            }\n        }\n\n        \/* Card Container *\/\n        .card-container {\n            display: flex;\n            gap: 20px;\n            flex-wrap: wrap;\n            justify-content: center;\n            padding: 20px;\n        }\n\n        \/* Card Styles *\/\n        .card {\n            width: 500px;\n            height: 500px;\n            border-radius: 12px;\n            overflow: hidden;\n            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.2);\n            position: relative;\n            cursor: pointer;\n            perspective: 1000px;\n            transition: width 0.3s ease, height 0.3s ease;\n        }\n\n        \/* Responsive Card Size *\/\n        @media (max-width: 768px) {\n            .card {\n                width: 90%;\n                height: auto;\n                aspect-ratio: 1 \/ 1;\n            }\n        }\n\n        \/* Image and Info Slide Container *\/\n        .slide-container {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            transition: transform 0.6s ease;\n        }\n\n        \/* Image Slide *\/\n        .image-slide {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background-color: #fff;\n        }\n\n        .image-slide img {\n            width: 100%;\n            height: 100%;\n            object-fit: cover;\n            filter: grayscale(100%); \/* Apply grayscale only to images *\/\n            transition: filter 0.3s ease;\n        }\n\n        \/* Hover effect to bring color back *\/\n        .card:hover .image-slide img {\n            filter: grayscale(0%); \/* Remove grayscale on hover *\/\n        }\n\n        \/* Info Slide *\/\n        .info-slide {\n            position: absolute;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            flex-direction: column;\n            align-items: center;\n            justify-content: center;\n            background-color: #2A75AA;\n            color: #fff;\n            text-align: center;\n            padding: 20px;\n            transform: translateX(100%);\n        }\n\n        \/* Toggle Slide on Click *\/\n        .card.active .slide-container {\n            transform: translateX(-100%);\n        }\n\n        \/* Simple \"Shop Now\" Button with Hover Glow Effect *\/\n        .shop-now-button {\n            margin-top: 20px;\n            padding: 12px 24px;\n            font-size: 1rem;\n            color: #fff;\n            background-color: #2A75AA;\n            border: 2px solid transparent;\n            border-radius: 8px;\n            cursor: pointer;\n            text-decoration: none;\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n            transition: color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;\n        }\n\n        \/* Glow effect on hover *\/\n        .shop-now-button:hover {\n            box-shadow: 0 0 15px rgba(42, 117, 170, 0.6), 0 0 25px rgba(42, 117, 170, 0.4);\n            transform: scale(1.05);\n        }\n\n        \/* White Text Glow on Hover *\/\n        .shop-now-button:hover {\n            color: #fff;\n            text-shadow: 0 0 8px rgba(255, 255, 255, 0.8), 0 0 12px rgba(255, 255, 255, 0.6);\n        }\n\n        \/* Coming Soon Style *\/\n        .coming-soon {\n            position: absolute;\n            top: 0;\n            left: 0;\n            width: 100%;\n            height: 100%;\n            display: flex;\n            align-items: center;\n            justify-content: center;\n            background-color: #2A75AA;\n            color: #fff;\n            font-size: 1.5rem;\n            text-align: center;\n            opacity: 0;\n            transition: opacity 0.3s ease;\n        }\n\n        \/* Show \"Coming Soon\" on click *\/\n        .card.coming-soon-active .coming-soon {\n            opacity: 1;\n        }\n    <\/style>\n<\/head>\n<body>\n\n    <!-- Center-Aligned Header -->\n    <h1 id=\"dynamic-header\">The Essential Extensions<\/h1>\n\n    <!-- Card Container with Interactive Image Cards -->\n    <div class=\"card-container\">\n        \n        <!-- Card 1: EssentialFX -->\n        <div class=\"card\" onclick=\"toggleCard(this)\">\n            <div class=\"slide-container\">\n                <!-- Image Slide -->\n                <div class=\"image-slide\">\n                    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0615\/9532\/0575\/files\/EssentialFXV3BlueTheme_de6bb610-e689-40e3-af95-09ce748d3faf.jpg?v=1730699589\" alt=\"EssentialFX\">\n                <\/div>\n                <!-- Info Slide -->\n                <div class=\"info-slide\">\n                    <p><strong>EssentialFX:<\/strong><br>Take your video editing to the next level with advanced effects, speed ramping, and workflow automation in Adobe After Effects.<\/p>\n                    <a href=\"https:\/\/djordanmedia.com\/products\/essentialfx-1\" target=\"_blank\" class=\"shop-now-button\">Shop Now<\/a>\n                <\/div>\n            <\/div>\n        <\/div>\n        \n        <!-- Card 2: Essential SFX -->\n        <div class=\"card\" onclick=\"toggleCard(this)\">\n            <div class=\"slide-container\">\n                <!-- Image Slide -->\n                <div class=\"image-slide\">\n                    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0615\/9532\/0575\/files\/essential_SFX_2024.jpg?v=1723603043\" alt=\"Essential SFX\">\n                <\/div>\n                <!-- Info Slide -->\n                <div class=\"info-slide\">\n                    <p><strong>Essential SFX:<\/strong><br>Enhance your audio experience with over 300 sounds for **After Effects** and **Premiere Pro**, designed for professional projects.<\/p>\n                    <a href=\"https:\/\/djordanmedia.com\/products\/essentialsfx\" target=\"_blank\" class=\"shop-now-button\">Shop Now<\/a>\n                <\/div>\n            <\/div>\n        <\/div>\n        \n        <!-- Card 3: EssentialAI (Coming Soon) -->\n        <div class=\"card coming-soon-card\" onclick=\"toggleComingSoon(this)\">\n            <div class=\"slide-container\">\n                <!-- Image Slide -->\n                <div class=\"image-slide\">\n                    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0615\/9532\/0575\/files\/Essential_AI.jpg?v=1723604363\" alt=\"EssentialAI\">\n                <\/div>\n            <\/div>\n            <!-- Coming Soon Overlay -->\n            <div class=\"coming-soon\">Coming Soon<\/div>\n        <\/div>\n        \n        <!-- Card 4: Essential Bundle (Info Slide with Updated Text) -->\n        <div class=\"card\" onclick=\"toggleCard(this)\">\n            <div class=\"slide-container\">\n                <!-- Image Slide -->\n                <div class=\"image-slide\">\n                    <img src=\"https:\/\/cdn.shopify.com\/s\/files\/1\/0615\/9532\/0575\/files\/Essentialbundlepackv2.jpg?v=1730699482\" alt=\"Essential Bundle\">\n                <\/div>\n                <!-- Info Slide -->\n                <div class=\"info-slide\">\n                    <p><strong>Essential Bundle:<\/strong><br>Get all our essentials with lifetime updates, ensuring you're always up-to-date with the latest tools and features.<\/p>\n                    <a href=\"https:\/\/djordanmedia.com\/products\/essential-extensions-bundle\" target=\"_blank\" class=\"shop-now-button\">Shop Now<\/a>\n                <\/div>\n            <\/div>\n        <\/div>\n\n    <\/div>\n\n    <!-- JavaScript for Toggle Effect -->\n    <script>\n        const header = document.getElementById(\"dynamic-header\");\n\n        function toggleCard(card) {\n            card.classList.toggle('active');\n            header.classList.add(\"active-glow\");\n\n            \/\/ Remove the glow after a delay\n            setTimeout(() => {\n                header.classList.remove(\"active-glow\");\n            }, 3000);\n        }\n\n        function toggleComingSoon(card) {\n            card.classList.toggle('coming-soon-active');\n        }\n    <\/script>\n\n<\/body>\n<\/html>",
            "width": "100%",
            "alignment": "center"
          }
        }
