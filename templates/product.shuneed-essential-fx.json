    "faq_Yem8pm": {
      "type": "faq",
      "blocks": {
        "question_ppRNgw": {
          "type": "question",
          "settings": {
            "title": "Is this a preset pack or a plugin?",
            "text": "<p>EssentialFX is not just presets—it's a <strong>full After Effects extension</strong> with real tools, custom interfaces, and advanced workflow features.<br/><br/>Built by professional editors to solve real editing problems.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_3NjNaD": {
          "type": "question",
          "settings": {
            "title": "Do I get future updates with my purchase?",
            "text": "<p>Yes!</p><ul><li><br/>Version License, you'll receive all updates within Version 4 (e.g., 4.0, 4.1, 4.2...).<br/></li><li><br/>Lifetime License, you’ll get every future version we release—forever.<br/></li></ul>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_W3tHCh": {
          "type": "question",
          "settings": {
            "title": "Do I need to be advanced to use EssentialFX?",
            "text": "<p>Nope!<br/><br/>EssentialFX is designed for both <strong>beginner and advanced editors.</strong> Every feature is intuitive, labeled, and designed to make complex edits easier—not harder.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_m86FRU": {
          "type": "question",
          "settings": {
            "title": "Do you offer customer support if I have issues?",
            "text": "<p>Yes—and it’s one of the things we’re known for.<br/><br/>Our support is fast, personal, and trusted by hundreds of creators. We go above and beyond to make sure you're fully satisfied—with an <strong>almost guaranteed success rate</strong> in resolving any issues.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_XKx7k3": {
          "type": "question",
          "settings": {
            "title": "How many devices can I install it on?",
            "text": "<p>Each license includes <strong>2 activations</strong> (ideal for a desktop + laptop).<br/><br/>Need more? The <strong>Studio License</strong> includes up to <strong>8 activations</strong> for teams and multi-device workflows.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_7ywVdW": {
          "type": "question",
          "settings": {
            "title": "Will this work on both Mac and Windows?",
            "text": "<p>Absolutely. EssentialFX works seamlessly on both <strong>Mac and Windows</strong>, as long as you're using <strong>Adobe After Effects 2024 or newer</strong>.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        }
      },
