          "settings": {
            "code": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n    <meta charset=\"UTF-8\" \/>\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\"\/>\n    <title>DJordanMedia's $3250 Editing Contest<\/title>\n    <style>\n        \/* Colors based on provided theme *\/\n        :root {\n            --background: #F0EDE0; \/* Cream *\/\n            --text: #1C1E24;\n            --buttons: #2A75AA;\n            --button-text: #FFFFFF;\n            --highlight: #FF4500;\n            --header-bg: #2A75AA;\n            --header-text: #F0EDE0;\n        }\n\n        body {\n            margin: 0;\n            padding: 0;\n            font-family: Arial, sans-serif;\n            background: var(--background);\n            color: var(--text);\n        }\n\n        \/* Hero Section *\/\n        .hero {\n            padding: 50px 20px;\n            display: flex;\n            flex-direction: column;\n            justify-content: center;\n            align-items: center;\n            background: linear-gradient(to bottom, var(--header-bg) 0%, var(--background) 100%);\n            text-align: center;\n            position: relative;\n            overflow: hidden;\n        }\n\n        .hero h1 {\n            font-size: 3em;\n            color: var(--header-text);\n            margin-bottom: 15px;\n            text-shadow: 0 0 10px rgba(0,0,0,0.3), 0 0 20px var(--highlight);\n        }\n\n        .hashtag {\n            display: inline-block;\n            font-size: 1.2em;\n            color: var(--header-text);\n            background: rgba(0,0,0,0.2);\n            padding: 5px 10px;\n            border-radius: 20px;\n            margin-bottom: 20px;\n            text-shadow: 0 0 5px rgba(0,0,0,0.2);\n        }\n\n        .hero p {\n            font-size: 1.2em;\n            color: var(--header-text);\n            max-width: 600px;\n            margin: 0 auto 20px auto;\n            line-height: 1.5;\n            text-shadow: 0 0 5px rgba(0,0,0,0.1);\n        }\n\n        .hero-button {\n            display: inline-block;\n            background: linear-gradient(45deg, var(--buttons), var(--highlight));\n            color: var(--button-text);\n            padding: 10px 25px;\n            border-radius: 30px;\n            font-size: 1.1em;\n            font-weight: bold;\n            text-decoration: none;\n            transition: all 0.3s ease-in-out;\n            box-shadow: 0 0 10px var(--buttons), 0 0 20px var(--highlight);\n            cursor: pointer;\n        }\n\n        .hero-button:hover {\n            background: var(--buttons);\n            box-shadow: 0 0 15px var(--buttons), 0 0 25px var(--highlight);\n            transform: translateY(-3px);\n        }\n    <\/style>\n<\/head>\n<body>\n    <section class=\"hero\">\n        <h1>DJordanMedia's $3250 Editing Contest<\/h1>\n        <div class=\"hashtag\">#DJordanContest<\/div>\n        <p>Show off your editing prowess and seize the chance to win a Sony A7IV Bundle! Impress us with your creative vision, technique, and originality. Let’s celebrate the art of editing and empower creators worldwide.<\/p>\n        <a href=\"https:\/\/youtu.be\/7BPtweNi1PM\" target=\"_blank\" class=\"hero-button\">\n          Watch the Contest Overview Here\n        <\/a>\n    <\/section>\n<\/body>\n<\/html>",
