    "advanced_content_ALkxJK": {
      "type": "advanced-content",
      "blocks": {
        "liquid_wLPBf3": {
          "type": "liquid",
          "settings": {
            "code": "<style>\n    :root {\n        --background: #F0EDE0; \/* Cream *\/\n        --text: #1C1E24;\n        --buttons: #2A75AA;\n        --button-text: #FFFFFF;\n        --highlight: #FF4500;\n        --header-bg: #2A75AA;\n        --header-text: #F0EDE0;\n    }\n\n    body {\n        margin: 0; \n        padding: 0; \n        font-family: Arial, sans-serif;\n    }\n\n    .prizes-section {\n        background: var(--background);\n        color: var(--text);\n        text-align: center;\n        padding: 80px 20px;\n        border-top: 2px solid var(--buttons);\n        position: relative;\n        max-width: 1200px;\n        margin: 0 auto;\n    }\n\n    .prizes-section h2 {\n        font-size: 2.5em;\n        margin-bottom: 20px;\n        color: var(--text);\n        text-shadow: 0 0 5px rgba(0,0,0,0.1);\n    }\n\n    .prizes-intro {\n        font-size: 1.1em;\n        max-width: 600px;\n        margin: 0 auto 60px auto;\n        line-height: 1.5;\n        color: var(--text);\n    }\n\n    .prizes-grid {\n        display: grid;\n        \/* Reduced min width from 250px to 200px for better mobile fit *\/\n        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));\n        gap: 40px;\n        max-width: 1000px;\n        margin: 0 auto;\n        padding: 0 20px;\n    }\n\n    .prize-card {\n        background: var(--header-bg);\n        color: var(--header-text);\n        padding: 30px 20px;\n        border-radius: 15px;\n        box-shadow: 0 0 15px rgba(0,0,0,0.1);\n        transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;\n        position: relative;\n    }\n\n    .prize-card h3 {\n        font-size: 1.8em;\n        margin-bottom: 10px;\n    }\n\n    .prize-value {\n        font-size: 1.2em;\n        margin-bottom: 20px;\n        font-weight: bold;\n    }\n\n    .prize-details {\n        list-style: none;\n        padding: 0;\n        margin: 0;\n        font-size: 1em;\n        line-height: 1.5;\n    }\n\n    .prize-details li {\n        margin-bottom: 10px;\n    }\n\n    .grand-prize {\n        grid-column: span 2;\n        background: linear-gradient(45deg, var(--buttons), var(--highlight));\n        color: var(--button-text);\n        box-shadow: 0 0 20px rgba(0,0,0,0.2);\n    }\n\n    .prize-card:hover {\n        transform: translateY(-5px);\n        box-shadow: 0 0 20px rgba(0,0,0,0.15);\n        background: linear-gradient(45deg, var(--buttons), var(--highlight));\n        color: var(--button-text);\n    }\n\n    @media (max-width: 600px) {\n        .prize-card h3 {\n            font-size: 1.5em;\n        }\n        .prize-value {\n            font-size: 1em;\n        }\n\n        \/* On small screens, ensure grand prize doesn't try to span two columns *\/\n        .grand-prize {\n            grid-column: 1 \/ -1;\n        }\n    }\n<\/style>\n\n<section class=\"prizes-section\">\n    <h2>What’s Up For Grabs?<\/h2>\n    <p class=\"prizes-intro\">Free to enter, free to download—win top-tier gear, cash, and exclusive editing bundles. It’s time to take your editing skills to new heights!<\/p>\n\n    <div class=\"prizes-grid\">\n        <!-- Grand Prize Card -->\n        <div class=\"prize-card grand-prize\">\n            <h3>Grand Prize<\/h3>\n            <p class=\"prize-value\">Sony A7IV Bundle<\/p>\n            <ul class=\"prize-details\">\n                <li>Full-Frame Mirrorless Camera<\/li>\n                <li>Included Lens & 128GB SD Card<\/li>\n                <li>The Ultimate Content Creator’s Tool<\/li>\n            <\/ul>\n        <\/div>\n\n        <!-- Runner-Up Prizes -->\n        <div class=\"prize-card\">\n            <h3>2nd Place<\/h3>\n            <p class=\"prize-value\">$300 + EssentialFX Bundle<\/p>\n        <\/div>\n        <div class=\"prize-card\">\n            <h3>3rd Place<\/h3>\n            <p class=\"prize-value\">$100 + EssentialFX Bundle<\/p>\n        <\/div>\n        <div class=\"prize-card\">\n            <h3>4th - 10th<\/h3>\n            <p class=\"prize-value\">$50 each<\/p>\n        <\/div>\n        <div class=\"prize-card\">\n            <h3>Honorable Mentions<\/h3>\n            <p class=\"prize-value\">Recognition & Credit<\/p>\n        <\/div>\n    <\/div>\n<\/section>",
            "width": "100%",
            "alignment": "center"
          }
        },
