    "advanced_content_zFRECR": {
      "type": "advanced-content",
      "blocks": {
        "liquid_Ap7PFm": {
          "type": "liquid",
          "settings": {
            "code": "<style>\n    :root {\n        --background: #F0EDE0; \/* Cream *\/\n        --text: #1C1E24;\n        --buttons: #2A75AA;\n        --button-text: #FFFFFF;\n        --highlight: #FF4500;\n        --header-bg: #2A75AA;\n        --header-text: #F0EDE0;\n    }\n\n    body {\n        margin: 0; \n        padding: 0; \n        font-family: Arial, sans-serif;\n    }\n\n    .how-to-enter {\n        background: var(--background);\n        color: var(--text);\n        text-align: center;\n        padding: 80px 20px;\n        border-top: 2px solid var(--buttons);\n        max-width: 1200px;\n        margin: 0 auto;\n        position: relative;\n    }\n\n    .how-to-enter h2 {\n        font-size: 2.5em;\n        margin-bottom: 20px;\n        color: var(--text);\n        text-shadow: 0 0 5px rgba(0,0,0,0.1);\n    }\n\n    .how-to-intro {\n        font-size: 1.1em;\n        max-width: 600px;\n        margin: 0 auto 60px auto;\n        line-height: 1.5;\n        color: var(--text);\n    }\n\n    .steps-grid {\n        display: grid;\n        grid-template-columns: 1fr; \/* Default single-column for mobile *\/\n        gap: 40px;\n        max-width: 1000px;\n        margin: 0 auto;\n        padding: 0 20px;\n        justify-items: center;\n    }\n\n    \/* On larger screens, display all five steps in a single row *\/\n    @media (min-width: 600px) {\n        .steps-grid {\n            grid-template-columns: repeat(5, 1fr);\n        }\n    }\n\n    .step-card {\n        background: var(--header-bg);\n        color: var(--header-text);\n        padding: 30px 20px;\n        border-radius: 15px;\n        box-shadow: 0 0 15px rgba(0,0,0,0.1);\n        transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease, color 0.3s ease;\n        position: relative;\n        text-align: center;\n        max-width: 200px;\n    }\n\n    .step-card:hover {\n        transform: translateY(-5px);\n        box-shadow: 0 0 20px rgba(0,0,0,0.15);\n        background: linear-gradient(45deg, var(--buttons), var(--highlight));\n        color: var(--button-text);\n    }\n\n    .step-number {\n        display: block;\n        width: 40px; \n        height: 40px; \n        background: var(--highlight);\n        color: var(--button-text);\n        border-radius: 50%;\n        font-weight: bold;\n        font-size: 1.2em;\n        line-height: 40px;\n        text-align: center;\n        margin: 0 auto 10px auto;\n    }\n\n    .step-title {\n        font-size: 1.4em;\n        margin-bottom: 10px;\n    }\n\n    .step-description {\n        font-size: 1em;\n        line-height: 1.4;\n    }\n\n    \/* Sequential gradients for each step *\/\n    .steps-grid .step-card:nth-child(1) {\n        background: linear-gradient(45deg, #2A75AA, #2A75AA);\n    }\n\n    .steps-grid .step-card:nth-child(2) {\n        background: linear-gradient(45deg, #2A75AA, #428B9A);\n    }\n\n    .steps-grid .step-card:nth-child(3) {\n        background: linear-gradient(45deg, #2A75AA, #5A9F85);\n    }\n\n    .steps-grid .step-card:nth-child(4) {\n        background: linear-gradient(45deg, #2A75AA, #78AE5D);\n    }\n\n    .steps-grid .step-card:nth-child(5) {\n        background: linear-gradient(45deg, #2A75AA, #FF4500);\n    }\n\n    @media (max-width: 600px) {\n        .step-title {\n            font-size: 1.2em;\n        }\n    }\n\n    .rules-link {\n        margin-top: 40px;\n        font-size: 1em;\n    }\n\n    .rules-link a {\n        color: var(--buttons);\n        text-decoration: underline;\n        font-weight: bold;\n    }\n<\/style>\n\n<section class=\"how-to-enter\">\n    <h2>How to Enter<\/h2>\n    <p class=\"how-to-intro\">Ready to join the contest? Just follow these simple steps to get started.<\/p>\n\n    <div class=\"steps-grid\">\n        <div class=\"step-card\">\n            <span class=\"step-number\">1<\/span>\n            <h3 class=\"step-title\">Follow & Subscribe<\/h3>\n            <p class=\"step-description\">\n                Follow DJordanMedia on Instagram and subscribe on YouTube to stay up-to-date.\n            <\/p>\n        <\/div>\n\n        <div class=\"step-card\">\n            <span class=\"step-number\">2<\/span>\n            <h3 class=\"step-title\">\"Purchase\" the Free Assets<\/h3>\n            <p class=\"step-description\">\n                Add the free contest product to your cart and complete the checkout process (no charge).\n            <\/p>\n        <\/div>\n\n        <div class=\"step-card\">\n            <span class=\"step-number\">3<\/span>\n            <h3 class=\"step-title\">Edit Your Video<\/h3>\n            <p class=\"step-description\">\n                Use your creative vision to edit the provided footage, incorporating the contest logo.\n            <\/p>\n        <\/div>\n\n        <div class=\"step-card\">\n            <span class=\"step-number\">4<\/span>\n            <h3 class=\"step-title\">Post & Tag<\/h3>\n            <p class=\"step-description\">\n                Upload your final edit to Instagram, YouTube, or TikTok. Include #DJordanContest and tag @djordanmedia.\n            <\/p>\n        <\/div>\n\n        <div class=\"step-card\">\n            <span class=\"step-number\">5<\/span>\n            <h3 class=\"step-title\">Submit Your Entry<\/h3>\n            <p class=\"step-description\">\n                Complete the submission form on this page, providing your video link.\n            <\/p>\n        <\/div>\n    <\/div>\n\n    <p class=\"rules-link\">\n        For full contest rules and guidelines, please visit the <a href=\"https:\/\/djordanmedia.com\/pages\/editing-contest-rules\" target=\"_blank\">Rules Page<\/a>.\n    <\/p>\n<\/section>",
            "width": "100%",
            "alignment": "center"
          }
        }
      },
