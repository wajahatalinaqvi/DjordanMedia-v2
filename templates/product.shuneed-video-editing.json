    "faq_Yem8pm": {
      "type": "faq",
      "blocks": {
        "question_ppRNgw": {
          "type": "question",
          "settings": {
            "title": "What will I learn in this course?",
            "text": "<p>You’ll learn everything from beginner-level After Effects to advanced speed ramping, transitions, sound design, effects, cinematic grading, and editing techniques that help you create viral-quality content. The lessons are step-by-step with real footage to follow along.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_3NjNaD": {
          "type": "question",
          "settings": {
            "title": "Is this just for car or automotive edits?",
            "text": "<p>Not at all. While many students are in the car scene, the techniques you’ll learn apply to any niche — music videos, content creation, brand promos, social media edits, and more.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_W3tHCh": {
          "type": "question",
          "settings": {
            "title": "Will I get support if I’m stuck?",
            "text": "<p>Definitely. You’ll be invited to a private Discord community where you can ask questions, share your work, get feedback, and connect with over 600 other creators worldwide, alongside myself.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_m86FRU": {
          "type": "question",
          "settings": {
            "title": "Is this course beginner-friendly?",
            "text": "<p>Yes — 75% of students started with little to no After Effects experience. The course is built to take you from zero to advanced in a structured and easy-to-follow way.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_XKx7k3": {
          "type": "question",
          "settings": {
            "title": "Are Updates Included?",
            "text": "<p>Yes — when you enroll into the complete editing bundle, you get access to all current content<em>and</em>any future updates or new lessons added to the bundle, at no extra cost.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        },
        "question_7ywVdW": {
          "type": "question",
          "settings": {
            "title": "What if I'm already experienced with after effects?",
            "text": "<p>Even experienced editors have leveled up with this course — especially when it comes to mastering speed ramps, workflow optimization, and advanced effect layering. Plus, it saves hours of trial and error.</p>",
            "question_color": "#afaa95",
            "use_question_gradient": true,
            "question_gradient_end_color": "#ffffff",
            "question_gradient_direction": 90,
            "answer_color": "#cccccc",
            "use_answer_gradient": false,
            "answer_gradient_end_color": "#999999",
            "answer_gradient_direction": 90
          }
        }
