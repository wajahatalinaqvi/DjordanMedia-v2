    "faq_eDqC6H": {
      "type": "faq",
      "blocks": {
        "question_BrDLrg": {
          "type": "question",
          "settings": {
            "title": "How much time can EssentialFX actually save me?",
            "text": "<p>Most editors save <strong>hours per project<\/strong> by cutting out repetitive tasks like searching for effects, building ramps, or setting up layers manually. It's built to speed up your entire workflow from start to finish. Not only is it used to speed up workflows, but its used to unlock creativity and accuracy.<\/p>"
          }
        },
        "question_d7UwaN": {
          "type": "question",
          "settings": {
            "title": "Do I get updates for free?",
            "text": "<p>Nope! No additional payments! all Essential Extensions come with free updates. We are committed to enhancing our products, and you will receive ongoing updates with new features, effects, and improvements at no additional cost.<\/p>"
          }
        },
        "question_eYiYKK": {
          "type": "question",
          "settings": {
            "title": "Is this included in any bundles?",
            "text": "<p>Yes! EssentialFX is also part of our <strong>Essential Extensions Bundle<\/strong> and <strong>Platinum Bundle<\/strong>, which include SFX, Shake, LUTs, courses, and more at a discounted rate.<\/p>"
          }
        },
        "question_nbFiKx": {
          "type": "question",
          "settings": {
            "title": "Can I save my own presets inside EssentialFX?",
            "text": "<p>Yes! You can <strong>save your favorite speedramps, effect setups, and more<\/strong> to reuse in any project. Your custom workflow becomes faster every time you open it.<\/p>"
          }
        },
        "question_KiYF8T": {
          "type": "question",
          "settings": {
            "title": "How many devices can I install EssentialFX on?",
            "text": "<p>You get <strong>2 activations per purchase<\/strong>, so you can use it on your main setup and a backup system. For multi licenses, please notify us<\/p>"
          }
        },
        "question_j4NC8C": {
          "type": "question",
          "settings": {
            "title": "What versions of After Effects are supported?",
            "text": "<p>EssentialFX works with <strong>Adobe After Effects 2024 and newer<\/strong>.<\/p>"
          }
        },
        "question_gVcfRY": {
          "type": "question",
          "settings": {
            "title": "How does the Speedramp Controller work?",
            "text": "<p>It lets you create <strong>cinematic speed ramps automatically<\/strong> — no keyframes needed. Just select your layer, adjust the curve strength, and click apply. It even prevents frame glitches and supports multi-ramp setups with our remapping section.<\/p>"
          }
        },
        "question_GQUrJN": {
          "type": "question",
          "settings": {
            "title": "Is EssentialFX compatible with both Mac and Windows?",
            "text": "<p>Yes! EssentialFX runs smoothly on both <strong>macOS and Windows<\/strong>, as long as you have Adobe After Effects 2024 or newer.<\/p>"
          }
        },
        "question_9pgCYb": {
          "type": "question",
          "settings": {
            "title": "How do I install EssentialFX?",
            "text": "<p>After purchase, you’ll receive a <strong>download link and full installation guide<\/strong>. The process is quick, and our team is here if you need help. All you have to do is run our mac or windows installer file and follow the instructions.<\/p>"
          }
        },
        "question_y9BJLM": {
          "type": "question",
          "settings": {
            "title": "Can I request new features or effects?",
            "text": "<p>Absolutely! We’re always improving EssentialFX based on community feedback. Just shoot us an email — we actually listen.<\/p>"
          }
        },
        "question_4f8Gia": {
          "type": "question",
          "settings": {
            "title": "Do I need to manually update every time there's a new version?",
            "text": "<p>We’ll notify you when updates are live. Just <strong>download the latest version<\/strong> from your account or the email link and replace the old one. All your saved settings and presets will stay intact.<\/p>"
          }
        }
      },
