{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

<div class="faq-section {% if section.settings.use_gradient_bg %}gradient-bg{% endif %}" 
     style="
       background-color: {{ section.settings.bg_color }};
       {% if section.settings.use_gradient_bg %}
         background: linear-gradient({{ section.settings.gradient_direction }}deg, {{ section.settings.bg_color }} 0%, {{ section.settings.gradient_end_color }} 100%);
       {% endif %}
     ">
  <div class="page-width page-width--narrow">
    
    {%- if section.settings.title != blank or section.settings.subtitle != blank -%}
      <header class="section-header faq-header">
        {% if section.settings.title != blank %}
          <h2 class="section-header__title faq-main-title"
             {% if section.settings.use_title_gradient %}
                style="
                  background: linear-gradient({{ section.settings.title_gradient_direction }}deg, {{ section.settings.title_color }} 0%, {{ section.settings.title_gradient_end_color }} 100%);
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                  background-clip: text;"
             {% else %}
                style="color: {{ section.settings.title_color }};"
             {% endif %}>
            {{ section.settings.title | escape }}
          </h2>
        {% endif %}
        
        {% if section.settings.subtitle != blank %}
          <p class="faq-subtitle"
             {% if section.settings.use_subtitle_gradient %}
                style="
                  background: linear-gradient({{ section.settings.subtitle_gradient_direction }}deg, {{ section.settings.subtitle_color }} 0%, {{ section.settings.subtitle_gradient_end_color }} 100%);
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                  background-clip: text;"
             {% else %}
                style="color: {{ section.settings.subtitle_color }};"
             {% endif %}>
            {{ section.settings.subtitle | escape }}
          </p>
        {% endif %}
      </header>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <script type="application/ld+json">
        {
          "@context": "https://schema.org",
          "@type": "FAQPage",
          "mainEntity": [
            {% for block in section.blocks %}
              {% case block.type %}
                {% when 'question' %}
                  {
                    "@type": "Question",
                    "name": {{ block.settings.title | json }},
                    "acceptedAnswer": {
                      "@type": "Answer",
                      "text": {{ block.settings.text | json }}
                    }
                  }{% unless forloop.last %},{% endunless %}
              {% endcase %}
            {% endfor %}
          ]
        }
      </script>

      <div class="faq-container">
        {%- for block in section.blocks -%}
          <div class="faq-item" {{ block.shopify_attributes }}>
            {% case block.type %}
              {% when 'rich-text'%}
                <div class="index-section index-section--faq">
                  <div class="text-{{ block.settings.align_text }}">
                    {%- if block.settings.title != blank -%}
                      <p class="h2">
                        {{ block.settings.title | escape }}
                      </p>
                    {%- endif -%}
                    {%- if block.settings.text != blank -%}
                      <div class="rte">
                        {%- if block.settings.enlarge_text %}<div class="enlarge-text">{% endif -%}
                          {{ block.settings.text }}
                        {%- if block.settings.enlarge_text %}</div>{% endif -%}
                      </div>
                    {%- endif -%}
                  </div>
                </div>

              {% when 'question'%}
                <div class="faq-question-wrapper">
                  <button type="button" class="faq-question" aria-controls="FAQ-content-{{ block.id }}"
                     {% if block.settings.use_question_gradient %}
                        style="
                          background: linear-gradient({{ block.settings.question_gradient_direction }}deg, {{ block.settings.question_color }} 0%, {{ block.settings.question_gradient_end_color }} 100%);
                          -webkit-background-clip: text;
                          -webkit-text-fill-color: transparent;
                          background-clip: text;"
                     {% else %}
                        style="color: {{ block.settings.question_color }};"
                     {% endif %}>
                    <span>{{ block.settings.title }}</span>
                    <div class="faq-icon">
                      <span class="icon-plus">+</span>
                      <span class="icon-minus">−</span>
                    </div>
                  </button>
                  <div id="FAQ-content-{{ block.id }}" class="faq-answer"
                     {% if block.settings.use_answer_gradient %}
                        style="
                          background: linear-gradient({{ block.settings.answer_gradient_direction }}deg, {{ block.settings.answer_color }} 0%, {{ block.settings.answer_gradient_end_color }} 100%);
                          -webkit-background-clip: text;
                          -webkit-text-fill-color: transparent;
                          background-clip: text;"
                     {% else %}
                        style="color: {{ block.settings.answer_color }};"
                     {% endif %}>
                    {{ block.settings.text }}
                  </div>
                </div>
            {% endcase %}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size == 0 -%}
      <div class="placeholder-noblocks">
        {{ 'home_page.onboarding.no_content' | t }}
      </div>
    {%- endif -%}
  </div>
</div>

{%- if section.settings.divider -%}</div>{%- endif -%}

<style>
  .faq-section {
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  
  .faq-header {
    text-align: center;
    margin-bottom: {{ section.settings.header_bottom_spacing }}px;
  }
  
  .faq-main-title {
    font-weight: {{ section.settings.title_weight }};
    font-size: {{ section.settings.title_size }}px;
    margin-bottom: 10px;
  }
  
  .faq-subtitle {
    font-size: {{ section.settings.subtitle_size }}px;
    margin-top: 0;
  }
  
  .faq-container {
    max-width: 800px;
    margin: 0 auto;
  }
  
  .faq-item {
    margin-bottom: {{ section.settings.question_spacing }}px;
  }
  
  .faq-question-wrapper {
    border: {% if section.settings.show_borders %}1px solid {{ section.settings.border_color }}{% else %}none{% endif %};
    border-radius: {{ section.settings.border_radius }}px;
    background-color: {{ section.settings.question_bg_color }};
    overflow: hidden;
  }
  
  .faq-question {
    display: flex;
    width: 100%;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    background: none;
    border: none;
    text-align: left;
    cursor: pointer;
    font-size: {{ section.settings.question_size }}px;
    font-weight: {{ section.settings.question_weight }};
  }
  
  .faq-icon {
    margin-left: 10px;
  }
  
  .icon-minus {
    display: none;
  }
  
  .faq-question.active .icon-plus {
    display: none;
  }
  
  .faq-question.active .icon-minus {
    display: block;
  }
  
  .faq-answer {
    display: none;
    padding: 0 20px 16px;
    font-size: {{ section.settings.answer_size }}px;
  }
  
  .faq-answer.active {
    display: block;
  }

  @media screen and (max-width: 768px) {
    .faq-main-title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }
    
    .faq-subtitle {
      font-size: {{ section.settings.subtitle_size_mobile }}px;
    }
    
    .faq-question {
      font-size: {{ section.settings.question_size_mobile }}px;
    }
    
    .faq-answer {
      font-size: {{ section.settings.answer_size_mobile }}px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    const faqQuestions = document.querySelectorAll('.faq-question');
    
    faqQuestions.forEach(question => {
      question.addEventListener('click', function() {
        const answer = this.nextElementSibling;
        const isActive = this.classList.contains('active');
        
        // Close all answers
        faqQuestions.forEach(q => {
          q.classList.remove('active');
          q.nextElementSibling.classList.remove('active');
        });
        
        // Toggle current answer
        if (!isActive) {
          this.classList.add('active');
          answer.classList.add('active');
        }
      });
    });
  });
</script>

