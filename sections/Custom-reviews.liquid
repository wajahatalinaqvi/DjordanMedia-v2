{% if section.settings.slider_mode == 'always' or section.settings.slider_mode == 'auto' and section.blocks.size > 4 %}
<!-- Slick slider CSS -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

<!-- Slick slider JS -->
<script src="https://cdn.jsdelivr.net/npm/jquery@3.6.0/dist/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>

<script type="text/javascript">
$(document).ready(function () {
  setTimeout(() => {
    initializeReviewsSlider();
  }, 300);

  function initializeReviewsSlider() {
    const $slider = $('#reviewsSlider');

    // Guard clause: No slider found
    if ($slider.length === 0) return;

    const slideCount = {{ section.blocks.size }};
    const maxSlides = Math.min({{ section.settings.max_reviews_per_row }}, slideCount);
    const showDots = {{ section.settings.show_dots | json }};
    const autoPlay = {{ section.settings.auto_slide | json }};
    const autoPlaySpeed = {{ section.settings.slider_speed | default: 3000 }};
    const enableArrows = false; // Change to true if needed

    // Destroy previous Slick instance if exists
    if ($slider.hasClass('slick-initialized')) {
      $slider.slick('unslick');
    }

    // Initialize Slick slider
    $slider.slick({
      slidesToShow: maxSlides,
      slidesToScroll: 1,
      arrows: enableArrows,
      dots: showDots,
      infinite: true,
      speed: 500,
      cssEase: 'cubic-bezier(0.25, 1, 0.5, 1)',
      waitForAnimate: true,
      adaptiveHeight: false,
      centerMode: false,
      centerPadding: '0px',
      autoplay: autoPlay,
      autoplaySpeed: autoPlaySpeed,
      pauseOnHover: true,
      pauseOnFocus: true,

      // Only include custom arrows if arrows are enabled
      ...(enableArrows && {
        appendArrows: $('.slider-controls'),
        prevArrow: $('.slider-prev'),
        nextArrow: $('.slider-next'),
      }),
      appendDots: $('#sliderDots'),

      // Responsive breakpoints
      responsive: [
        {
          breakpoint: 991,
          settings: {
            slidesToShow: 2,
            slidesToScroll: 1
          }
        },
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1,
            slidesToScroll: 1,
            arrows: true,
            dots: false
          }
        }
      ]
    });

    // Hide arrows manually in DOM if not needed
    if (!enableArrows) {
      $('.slider-prev, .slider-next').hide();
    }

    // Refresh on window resize
    $(window).on('resize', function () {
      clearTimeout(window._slickResizeTimer);
      window._slickResizeTimer = setTimeout(() => {
        if ($slider.hasClass('slick-initialized')) {
          $slider.slick('refresh');
        }
      }, 250);
    });

    // Refresh after images load (for height)
    $(window).on('load', function () {
      setTimeout(() => {
        if ($slider.hasClass('slick-initialized')) {
          $slider.slick('refresh');
        }
      }, 300);
    });

    // Debug log
    console.log('✅ Slick initialized:', {
      totalSlides: slideCount,
      visibleSlides: maxSlides
    });
  }
});
</script>


