{% schema %}
{
  "name": "Custom Reviews",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "main_heading",
      "label": "Main Heading",
      "default": "What our Users Say"
    },
    {
      "type": "text",
      "id": "colored_word",
      "label": "Word to Highlight",
      "default": "Users",
      "info": "This word in the heading will have a different color"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "colored_word_color",
      "label": "Highlighted Word Color",
      "default": "#4A90E2"
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Size (Desktop)",
      "default": 42,
      "min": 20,
      "max": 80,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Size (Mobile)",
      "default": 32,
      "min": 18,
      "max": 50,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Reviews Layout"
    },
    {
      "type": "range",
      "id": "max_reviews_per_row",
      "label": "Maximum Reviews per Row",
      "default": 3,
      "min": 1,
      "max": 4,
      "step": 1
    },
    {
      "type": "checkbox",
      "id": "enable_slider",
      "label": "Enable Slider",
      "default": true,
      "info": "Automatically converts to slider when there are more than 4 reviews"
    },
    {
      "type": "select",
      "id": "slider_mode",
      "label": "Slider Mode",
      "options": [
        {
          "value": "auto",
          "label": "Auto (Slider when > 4 reviews)"
        },
        {
          "value": "always",
          "label": "Always Slider"
        },
        {
          "value": "never",
          "label": "Never Slider"
        }
      ],
      "default": "auto"
    },
    {
      "type": "range",
      "id": "slider_speed",
      "label": "Slider Speed (ms)",
      "default": 5000,
      "min": 2000,
      "max": 9000,
      "step": 500,
      "unit": "ms"
    },
    {
      "type": "checkbox",
      "id": "show_dots",
      "label": "Show Slider Dots",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "center_mode",
      "label": "Enable Center Mode",
      "default": true,
      "info": "Centers the active slide for a showcase effect"
    },
    {
      "type": "checkbox",
      "id": "auto_slide",
      "label": "Enable Auto Slide",
      "default": true
    },
    {
      "type": "color",
      "id": "review_background",
      "label": "Review Box Background (Solid)",
      "default": "#1A1A1A"
    },
    {
      "type": "checkbox",
      "id": "use_gradient_background",
      "label": "Use Gradient Background for Reviews",
      "default": false
    },
    {
      "type": "color_background",
      "id": "review_gradient_background",
      "label": "Review Box Gradient Background",
      "default": "linear-gradient(135deg, #1A1A1A, #333333)"
    },
    {
      "type": "range",
      "id": "review_padding",
      "label": "Review Box Padding",
      "default": 30,
      "min": 15,
      "max": 50,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "review_border_radius",
      "label": "Review Box Border Radius",
      "default": 8,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "quote_size",
      "label": "Quote Icon Size",
      "default": 40,
      "min": 4,
      "max": 60,
      "step": 2,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "quote_color",
      "label": "Quote Icon Color",
      "default": "#4A90E2"
    },
    {
      "type": "image_picker",
      "id": "quote_icon_image",
      "label": "Custom Quote Icon (Optional)",
      "info": "Upload a custom quote icon instead of using the default"
    },
    {
      "type": "checkbox",
      "id": "enable_card_gradient_border",
      "label": "Enable Gradient Border for Cards",
      "default": true
    },
    {
      "type": "color_background",
      "id": "card_border_gradient",
      "label": "Card Border Gradient",
      "default": "linear-gradient(135deg, #4A90E2, #50E3C2)"
    },
    {
      "type": "range",
      "id": "border_glow_intensity",
      "label": "Border Glow Intensity",
      "default": 80,
      "min": 10,
      "max": 100,
      "step": 10,
      "unit": "%"
    },
    {
      "type": "range",
      "id": "border_glow_spread",
      "label": "Border Glow Spread",
      "default": 8,
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "header",
          "content": "Reviewer Details"
        },
        {
          "type": "image_picker",
          "id": "reviewer_image",
          "label": "Reviewer Image"
        },
        {
          "type": "checkbox",
          "id": "use_image_background",
          "label": "Add Gradient Background to Image",
          "default": true
        },
        {
          "type": "color_background",
          "id": "image_background",
          "label": "Image Background Gradient",
          "default": "linear-gradient(135deg, #4A90E2, #50E3C2)"
        },
        {
          "type": "range",
          "id": "image_bg_opacity",
          "label": "Image Background Opacity",
          "default": 60,
          "min": 0,
          "max": 100,
          "step": 5,
          "unit": "%"
        },
        {
          "type": "text",
          "id": "reviewer_name",
          "label": "Reviewer Name",
          "default": "John Smith"
        },
        {
          "type": "color",
          "id": "name_color",
          "label": "Name Color (Solid)",
          "default": "#4A90E2"
        },
        {
          "type": "checkbox",
          "id": "use_name_gradient",
          "label": "Use Gradient for Name",
          "default": false
        },
        {
          "type": "color_background",
          "id": "name_gradient",
          "label": "Name Gradient",
          "default": "linear-gradient(to right, #4A90E2, #50E3C2)"
        },
        {
          "type": "text",
          "id": "reviewer_title",
          "label": "Reviewer Title",
          "default": "Motion Graphics Designer"
        },
        {
          "type": "color",
          "id": "title_color",
          "label": "Title Color (Solid)",
          "default": "#FFFFFF"
        },
        {
          "type": "checkbox",
          "id": "use_title_gradient",
          "label": "Use Gradient for Title",
          "default": false
        },
        {
          "type": "color_background",
          "id": "title_gradient",
          "label": "Title Gradient",
          "default": "linear-gradient(to right, #FFFFFF, #CCCCCC)"
        },
        {
          "type": "range",
          "id": "name_size_desktop",
          "label": "Name Font Size (Desktop)",
          "default": 18,
          "min": 14,
          "max": 30,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "name_size_mobile",
          "label": "Name Font Size (Mobile)",
          "default": 16,
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "title_size_desktop",
          "label": "Title Font Size (Desktop)",
          "default": 14,
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "title_size_mobile",
          "label": "Title Font Size (Mobile)",
          "default": 12,
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "header",
          "content": "Review Content"
        },
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Text",
          "default": "This course completely transformed my After Effects skills! What once was hard to follow, and required advanced technical approach, I can now create professional motion graphics and animations for my clients."
        },
        {
          "type": "color",
          "id": "review_text_color",
          "label": "Review Text Color (Solid)",
          "default": "#CCCCCC"
        },
        {
          "type": "checkbox",
          "id": "use_text_gradient",
          "label": "Use Gradient for Review Text",
          "default": false
        },
        {
          "type": "color_background",
          "id": "text_gradient",
          "label": "Review Text Gradient",
          "default": "linear-gradient(to right, #CCCCCC, #FFFFFF)"
        },
        {
          "type": "range",
          "id": "review_text_size_desktop",
          "label": "Review Text Size (Desktop)",
          "default": 16,
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "review_text_size_mobile",
          "label": "Review Text Size (Mobile)",
          "default": 14,
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Custom Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "reviewer_name": "John Smith",
            "reviewer_title": "Motion Graphics Designer",
            "review_text": "This course completely transformed my After Effects skills! What once was hard to follow, and required advanced technical approach, I can now create professional motion graphics and animations for my clients."
          }
        },
        {
          "type": "review",
          "settings": {
            "reviewer_name": "Emily Johnson",
            "reviewer_title": "Freelance Animator",
            "review_text": "I had basic knowledge of After Effects, but this course didn't take it to the next level. The techniques I learned are now part of my daily workflow, and the course made complex concepts simple."
          }
        },
        {
          "type": "review",
          "settings": {
            "reviewer_name": "Olivia Brown",
            "reviewer_title": "Creative Director",
            "review_text": "This is by far the best After Effects course I've ever taken. The lessons are detailed, practical and up-to-date with the latest trends in motion design. I can confidently create stunning animations now."
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.custom-reviews {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
  color: #fff;
}

.custom-reviews__container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 40px; /* Increase padding to account for quote icons */
  overflow: hidden; /* Prevent horizontal scrollbar */
}

@media screen and (max-width: 768px) {
  .custom-reviews__container {
    padding: 0 15px; /* Reduce padding on mobile */
  }
}


.custom-reviews__heading {
  text-align: center;
  width: 100%;
  display: flex;
  justify-content: center;
}

.custom-reviews__heading-text {
  font-size: {{ section.settings.heading_size_desktop }}px;
  font-weight: 600;
  color: {{ section.settings.heading_color }};
  margin: 0;
  line-height: 1.2;
  font-family: 'Poppins', sans-serif;
  text-align: center;
}

.custom-reviews__heading-colored {
  color: {{ section.settings.colored_word_color }};
  position: relative;
  display: inline-block;
}

.custom-reviews__grid {
  display: grid;
  grid-template-columns: repeat({{ section.settings.max_reviews_per_row }}, 1fr);
  gap: 30px;
}

.custom-reviews__grid.is-slider {
  display: block;
  position: relative;
  margin: 0;
  width: 100%;
}

.custom-reviews__slider {
  width: 100%;
  position: relative;
}

.custom-reviews__slider .slick-list {
  overflow: hidden; /* Change to hidden to prevent cards from overflowing */
  padding:0px 0;
  margin: 0 -10px; /* Compensate for slide margins */
}

.custom-reviews__slider .slick-track {
  display: flex;
  align-items: stretch;
  margin-left: 0; /* Fix alignment issues */
}

/* Proper spacing for slides */
.custom-reviews__slider .slick-slide {
  padding: 10px;
  box-sizing: border-box;
  height: auto;
  opacity: 1 !important; /* Ensure all slides are fully visible */
}

.custom-reviews__slide {
  display: flex;
  height: auto;
  box-sizing: border-box;
  padding: 0 10px; /* Add horizontal padding for slide spacing */
}

/* For non-slider mode, use grid layout */
.custom-reviews__grid:not(.is-slider) .custom-reviews__slide {
  flex: 0 0 auto;
  width: calc((100% / {{ section.settings.max_reviews_per_row }}) - 20px);
  box-sizing: border-box;
  margin: 0 10px 20px;
}

@media screen and (max-width: 991px) {
  .custom-reviews__grid:not(.is-slider) .custom-reviews__slide {
    width: calc(50% - 20px);
  }
}

@media screen and (max-width: 768px) {
  .custom-reviews__grid:not(.is-slider) .custom-reviews__slide {
    width: calc(100% - 20px);
  }
}

.slider-controls {
  display: flex;
  justify-content: center;
  align-items: center;
  margin-top: 30px;
  position: relative;
}

@media screen and (max-width: 768px) {
  .slider-controls {
    margin-top: 20px;
  }
}

.slider-arrow {
  background: rgba(255, 255, 255, 0.1);
  border: none;
  color: {{ section.settings.heading_color }};
  font-size: 22px;
  cursor: pointer;
  width: 40px;
  height: 40px;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  opacity: 0.7;
  transition: all 0.3s ease;
  z-index: 10;
}

.slider-arrow:hover {
  opacity: 1;
  background: rgba(255, 255, 255, 0.2);
}

.slider-prev {
  margin-right: 10px;
}

.slider-next {
  margin-left: 10px;
}

.slider-dots-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin: 0 20px;
  width: auto;
}

/* Slick will add dots dynamically */
.slider-dots-dots li {
  display: inline-block;
  margin: 0 4px;
}

.slider-dots-dots li button {
  border: 0;
  background: transparent;
  color: transparent;
  cursor: pointer;
  display: block;
  height: 8px;
  width: 8px;
  border-radius: 50%;
  padding: 0;
  outline: none;
  position: relative;
}

.slider-dots-dots li button:before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background-color: {{ section.settings.heading_color }};
  opacity: 0.3;
  transition: all 0.3s ease;
}

.slider-dots-dots li.slick-active button:before {
  opacity: 1;
  background-color: {{ section.settings.colored_word_color }};
}

.review-card {
  background: rgba(0, 0, 0, 0.3);
  padding: 40px 30px;
  border-radius: 16px;
  position: relative;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  overflow: visible !important;
  display: flex;
  flex-direction: column;
  height: 100%;
  box-shadow: 0 4px 30px rgba(0, 0, 0, 0.1);
  border: none;
  position: relative;
  z-index: 1;
}

{% if section.settings.enable_card_gradient_border %}
.review-card::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 2px;
  border-radius: 16px 16px 0 0;
  background: {{ section.settings.card_border_gradient }};
  opacity: {{ section.settings.border_glow_intensity | divided_by: 100.0 }};
  pointer-events: none;
  z-index: 0;
}

.review-card::after {
  content: "";
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 2px;
  border-radius: 0 0 16px 16px;
  background: {{ section.settings.card_border_gradient }};
  opacity: {{ section.settings.border_glow_intensity | divided_by: 100.0 }};
  pointer-events: none;
  z-index: 0;
}
{% endif %}

.review-card__quote-icon {
  position: absolute;
  top: 10px;
  left: 10px;
  line-height: 1;
  z-index: 5;
  opacity: 0.5; /* Reduced opacity for better text readability */
  transform: translate(0, 0); /* Don't translate outside the card */
  {% if section.settings.quote_icon_image == blank %}
    font-family: Georgia, serif;
    font-size: 60px; /* Reduced size */
    color: {{ section.settings.quote_color }};
  {% else %}
    width: {{ section.settings.quote_size }}px;
    height: {{ section.settings.quote_size }}px;
  {% endif %}
}

.review-card__quote-icon img {
  
  object-fit: contain;
  display: block;
  position: relative;
  z-index: 10;
}

.review-card__quote-icon::before {
  {% if section.settings.quote_icon_image == blank %}
    content: '"';
  {% endif %}
  text-shadow: 0 0 10px rgba(0,0,0,0.3); /* Add shadow to help separate from text */
}

.review-card__content {
  position: relative;
  z-index: 2;
  flex-grow: 1;
  margin-bottom: 15px;
  margin-top: 5px; /* Add some top margin to separate from quote icon */
}

.review-card__text {
  margin: 0;
  line-height: 1.6;
  font-size: {{ section.settings.review_text_size_desktop }}px;
  font-weight: 300;
  font-family: 'Poppins', sans-serif;
  position: relative;
  padding-top: 5px;
  color: rgba(255,255,255,0.9);
  z-index: 10; /* Ensure text is above quote icon */
}

.reviewer {
  display: flex;
  align-items: center;
  gap: 15px;
  margin-bottom: 20px;
  position: relative;
}

.reviewer__image {
  width: 50px;
  height: 50px;
  border-radius: 50%;
  overflow: hidden;
  position: relative;
  border: 2px solid rgba(255,255,255,0.1);
  background: #121212;
  box-shadow: 0 4px 15px rgba(0,0,0,0.2);
}

.reviewer__image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  position: relative;
  z-index: 2;
}

.reviewer__image-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
  border-radius: 50%;
}

.reviewer__details {
  display: flex;
  flex-direction: column;
}

.reviewer__name {
  margin: 0;
  font-weight: 600;
  color: {{ section.settings.colored_word_color }};
  line-height: 1.2;
}

.reviewer__title {
  margin: 0;
  opacity: 0.8;
  font-size: 12px;
  font-weight: 300;
  line-height: 1.4;
}

@media screen and (max-width: 991px) {
  .custom-reviews__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media screen and (max-width: 768px) {
  .custom-reviews__heading-text {
    font-size: {{ section.settings.heading_size_mobile }}px;
  }
  
  .custom-reviews__grid:not(.is-slider) {
    grid-template-columns: 1fr;
    gap: 20px;
  }
  
  /* .custom-reviews__slide {
    flex: 0 0 calc(100% - 20px);
  }
   */
  .slider-controls {
    margin-top: 20px;
  }
  
  .slider-dots-dots {
    gap: 6px;
  }
  
  .slider-dot {
    width: 6px;
    height: 6px;
  }
  
  /* Better infinite loop positioning on mobile */
  .custom-reviews__slider.few-cards {
    padding: 0 10px;
  }
}
</style>

<div class="custom-reviews" id="shopify-section-{{ section.id }}">
  <div class="custom-reviews__container">
    <div class="custom-reviews__heading">
      <h2 class="custom-reviews__heading-text">
        {% assign heading = section.settings.main_heading %}
        {% assign colored_word = section.settings.colored_word %}
        {% assign parts = heading | split: colored_word %}
        {{ parts[0] }}<span class="colored-word">{{ colored_word }}</span>{% if parts[1] %}{{ parts[1] }}{% endif %}
      </h2>
    </div>
    
    {% assign use_slider = false %}
    {% if section.settings.slider_mode == 'always' or section.settings.slider_mode == 'auto' and section.blocks.size > 4 %}
      {% assign use_slider = true %}
    {% endif %}
    
    <div class="custom-reviews__grid{% if use_slider %} is-slider{% endif %}" id="reviewsContainer">
      {% if use_slider %}
        <div class="custom-reviews__slider" id="reviewsSlider">
      {% endif %}
      
      {% for block in section.blocks %}
        {% if block.type == "review" %}
          <div class="review-card{% if use_slider %} custom-reviews__slide{% endif %}" {{ block.shopify_attributes }} data-block-id="{{ block.id }}">
            <div class="review-card__quote-icon">
              {% if section.settings.quote_icon_image != blank %}
                <img src="{{ section.settings.quote_icon_image | image_url }}" 
                     width="{{ section.settings.quote_size | times: 2 }}" 
                     height="{{ section.settings.quote_size | times: 2 }}" 
                     alt="Quote icon" 
                     loading="lazy">
              {% endif %}
            </div>
            
            <div class="reviewer">
              {% if block.settings.reviewer_image %}
                <div class="reviewer__image">
                  {% if block.settings.use_image_background %}
                    <div class="reviewer__image-bg" style="
                      background: {{ block.settings.image_background }};
                      opacity: {{ block.settings.image_bg_opacity | divided_by: 100.0 }};">
                    </div>
                  {% endif %}
                  <img src="{{ block.settings.reviewer_image | image_url: width: 80 }}" width="40" height="40" alt="{{ block.settings.reviewer_name }}" loading="lazy">
                </div>
              {% endif %}
              
              <div class="reviewer__details">
                <h3 class="reviewer__name" style="
                  {% if block.settings.use_name_gradient %}
                    background: {{ block.settings.name_gradient }};
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                  {% else %}
                    color: {{ block.settings.name_color }};
                  {% endif %}
                  font-size: {{ block.settings.name_size_desktop }}px;">
                  {{ block.settings.reviewer_name }}
                </h3>
                <p class="reviewer__title" style="
                  {% if block.settings.use_title_gradient %}
                    background: {{ block.settings.title_gradient }};
                    -webkit-background-clip: text;
                    -webkit-text-fill-color: transparent;
                    background-clip: text;
                  {% else %}
                    color: {{ block.settings.title_color }};
                  {% endif %}
                  font-size: {{ block.settings.title_size_desktop }}px;">
                  {{ block.settings.reviewer_title }}
                </p>
              </div>
            </div>
            
            <div class="review-card__content">
              <p class="review-card__text" style="
                {% if block.settings.use_text_gradient %}
                  background: {{ block.settings.text_gradient }};
                  -webkit-background-clip: text;
                  -webkit-text-fill-color: transparent;
                  background-clip: text;
                {% else %}
                  color: {{ block.settings.review_text_color }};
                {% endif %}
                font-size: {{ block.settings.review_text_size_desktop }}px;">
                {{ block.settings.review_text }}
              </p>
            </div>
          </div>
        {% endif %}
      {% endfor %}
      
      {% if use_slider %}
        </div>
      {% endif %}
    </div>
    
    {% if use_slider and section.settings.enable_slider %}
      <div class="slider-controls">
        <button class="slider-arrow slider-prev" aria-label="Previous slide">&larr;</button>
        {% if section.settings.show_dots %}
          <div class="slider-dots-dots" id="sliderDots"></div>
        {% endif %}
        <button class="slider-arrow slider-next" aria-label="Next slide">&rarr;</button>
      </div>
    {% endif %}
  </div>
</div>

