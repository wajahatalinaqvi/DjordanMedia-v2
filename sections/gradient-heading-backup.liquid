{% comment %} {% schema %}
{
  "name": "Gradient Heading",
  "settings": [
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading Text",
      "default": "What You'll Get Inside The [gradient]Course![/gradient]",
      "info": "Use [gradient] and [/gradient] tags to mark which part of the text should have a gradient effect."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Font Size (Desktop)",
      "default": 48,
      "min": 24,
      "max": 72,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "default": 36,
      "min": 20,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Subheading Settings"
    },
    {
      "type": "text",
      "id": "subheading_text",
      "label": "Subheading Text",
      "default": "Discover amazing features in our [gradient]premium[/gradient] package",
      "info": "Use [gradient] and [/gradient] tags to mark which part of the text should have a gradient effect."
    },
    {
      "type": "range",
      "id": "subheading_size_desktop",
      "label": "Subheading Font Size (Desktop)",
      "default": 24,
      "min": 16,
      "max": 40,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "subheading_size_mobile",
      "label": "Subheading Font Size (Mobile)",
      "default": 18,
      "min": 14,
      "max": 28,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading Text Color",
      "default": "#9B9B9B"
    },
    {
      "type": "color",
      "id": "subheading_gradient_from",
      "label": "Subheading Gradient Start Color",
      "default": "#4A90E2"
    },
    {
      "type": "color",
      "id": "subheading_gradient_to",
      "label": "Subheading Gradient End Color",
      "default": "#7B68EE"
    },
    {
      "type": "range",
      "id": "heading_subheading_gap",
      "label": "Gap Between Heading and Subheading",
      "default": 20,
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Text Colors"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Text Color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "gradient_from",
      "label": "Gradient Text Start Color",
      "default": "#D9D3B9"
    },
    {
      "type": "color",
      "id": "gradient_to",
      "label": "Gradient Text End Color",
      "default": "#A39E8B"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "select",
      "id": "text_align",
      "label": "Text Alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Gradient Heading",
      "settings": {
        "heading_text": "What You'll Get Inside The [gradient]Course![/gradient]",
        "subheading_text": "Discover amazing features in our [gradient]premium[/gradient] package"
      }
    }
  ]
}
{% endschema %}

<style>
.gradient-heading-section {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.background_color }};
}

.gradient-heading-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  text-align: {{ section.settings.text_align }};
}

.gradient-heading-section .gradient-heading,
#gradient-heading-unique {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.heading_size_desktop }}px !important;
  font-weight: 400;
  margin: 0;
  line-height: 1.3;
  color: {{ section.settings.heading_color }};
  text-transform: capitalize;
  letter-spacing: 0.5px;
  margin-bottom: {{ section.settings.heading_subheading_gap }}px !important;
}

.gradient-heading-section .gradient-subheading,
#gradient-subheading-unique {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.subheading_size_desktop }}px !important;
  font-weight: 300;
  margin: 0;
  line-height: 1.4;
  color: {{ section.settings.subheading_color }};
  letter-spacing: 0.3px;
}

@media screen and (max-width: 768px) {
  .gradient-heading-section .gradient-heading,
  #gradient-heading-unique {
    font-size: {{ section.settings.heading_size_mobile }}px !important;
    margin-bottom: {{ section.settings.heading_subheading_gap }}px !important;
  }
  
  .gradient-heading-section .gradient-subheading,
  #gradient-subheading-unique {
    font-size: {{ section.settings.subheading_size_mobile }}px !important;
  }
}
</style>

<div class="gradient-heading-section">
  <div class="gradient-heading-container">
    <h2 class="gradient-heading" id="gradient-heading-unique">
      {% render 'gradient-word-maker', 
        text: section.settings.heading_text,
        start_color: section.settings.gradient_from,
        end_color: section.settings.gradient_to
      %}
    </h2>
    {% if section.settings.subheading_text != blank %}
      <p class="gradient-subheading" id="gradient-subheading-unique">
        {% render 'gradient-word-maker', 
          text: section.settings.subheading_text,
          start_color: section.settings.subheading_gradient_from,
          end_color: section.settings.subheading_gradient_to
        %}
      </p>
    {% endif %}
  </div>
</div> {% endcomment %}
