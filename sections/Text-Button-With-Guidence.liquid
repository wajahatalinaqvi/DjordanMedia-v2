{% schema %}
{
  "name": "Text Button With Guidance",
  "settings": [
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "default": 60,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Heading Settings"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading",
      "default": "What You'll Get Inside The [gradient]Course![/gradient]",
      "info": "Use [gradient] and [/gradient] tags to mark which part of the text should have a gradient effect."
    },
    {
      "type": "range",
      "id": "heading_size_desktop",
      "label": "Heading Font Size (Desktop)",
      "default": 32,
      "min": 18,
      "max": 72,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading Font Size (Mobile)",
      "default": 24,
      "min": 14,
      "max": 48,
      "step": 1,
      "unit": "px"
    },
    {
      "type": "color",
      "id": "subheading_gradient_from",
      "label": "Gradient Text Color From",
      "default": "#D9D3B9"
    },
    {
      "type": "color",
      "id": "subheading_gradient_to",
      "label": "Gradient Text Color To",
      "default": "#A39E8B"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text Alignment (Desktop)",
      "default": "left",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "justify",
          "label": "Justify"
        }
      ]
    },
    {
      "type": "select",
      "id": "text_alignment_mobile",
      "label": "Text Alignment (Mobile)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        },
        {
          "value": "justify",
          "label": "Justify"
        }
      ],
      "info": "Set text alignment specifically for mobile devices"
    },
    {
      "type": "select",
      "id": "text_vertical_alignment",
      "label": "Text Vertical Alignment",
      "default": "center",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ]
    },
    {
      "type": "range",
      "id": "text_button_gap",
      "label": "Gap Between Text and Button",
      "default": 30,
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px"
    },
    {
      "type": "header",
      "content": "Button Settings"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Get it!"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    },
    {
      "type": "select",
      "id": "button_alignment",
      "label": "Button Alignment (Desktop)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ]
    },
    {
      "type": "select",
      "id": "button_alignment_mobile",
      "label": "Button Alignment (Mobile)",
      "default": "center",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "info": "Set button alignment specifically for mobile devices"
    },
    {
      "type": "color",
      "id": "button_bg_from",
      "label": "Button Background Gradient From",
      "default": "#1A1A1A"
    },
    {
      "type": "color",
      "id": "button_bg_to",
      "label": "Button Background Gradient To",
      "default": "#2A2A2A"
    },
    {
      "type": "color",
      "id": "button_border_from",
      "label": "Button Border Gradient From",
      "default": "#191919"
    },
    {
      "type": "color",
      "id": "button_border_to",
      "label": "Button Border Gradient To",
      "default": "#D9D3B9"
    },
    {
      "type": "color",
      "id": "button_text_gradient_from",
      "label": "Button Text Gradient From",
      "default": "#D9D3B9"
    },
    {
      "type": "color",
      "id": "button_text_gradient_to",
      "label": "Button Text Gradient To",
      "default": "#A39E8B"
    },
    {
      "type": "header",
      "content": "Features Box Settings"
    },
    {
      "type": "color",
      "id": "features_bg_from",
      "label": "Features Box Background Start",
      "default": "#000000D9"
    },
    {
      "type": "color",
      "id": "features_bg_middle",
      "label": "Features Box Background Middle",
      "default": "#2C2C2CCC"
    },
    {
      "type": "color",
      "id": "features_bg_to",
      "label": "Features Box Background End",
      "default": "#232323CC"
    },
    {
      "type": "range",
      "id": "features_bg_angle",
      "label": "Features Box Gradient Angle",
      "default": 120,
      "min": 0,
      "max": 360,
      "step": 10,
      "unit": "deg"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Custom Icon"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Feature Text",
          "default": "Feature item"
        },
        {
          "type": "color",
          "id": "text_gradient_from",
          "label": "Text Gradient From",
          "default": "#FFFFFF"
        },
        {
          "type": "color",
          "id": "text_gradient_to",
          "label": "Text Gradient To",
          "default": "#FFFFFF"
        },
        {
          "type": "range",
          "id": "font_size_desktop",
          "label": "Font Size (Desktop)",
          "default": 16,
          "min": 12,
          "max": 24,
          "step": 1,
          "unit": "px"
        },
        {
          "type": "range",
          "id": "font_size_mobile",
          "label": "Font Size (Mobile)",
          "default": 14,
          "min": 10,
          "max": 20,
          "step": 1,
          "unit": "px"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Text Button With Guidance",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "text": "Step-by-Step Lessons in Adobe After Effects"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Creator Mindset & Workflow Training"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Speedramping & Viral Transitions"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Filming Process, Camera setup, and editing"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Private Discord Community Access"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Trusted by Over 600 Creators Worldwide"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Lifetime Access & Free Future Updates"
          }
        },
        {
          "type": "feature",
          "settings": {
            "text": "Practice Footage Included"
          }
        }
      ]
    }
  ]
}
{% endschema %}

<style>
.guidance-section {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background: #000000;
}

.guidance-container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
  display: grid;
  grid-template-columns: 1fr 1fr;
  align-items: {% if section.settings.text_vertical_alignment == 'top' %}start{% elsif section.settings.text_vertical_alignment == 'bottom' %}end{% else %}center{% endif %};
}

.text-side {
  text-align: {{ section.settings.text_alignment }} !important;
}

.guidance-section .guidance-heading,
#guidance-heading-unique {
  margin-bottom: {{ section.settings.text_button_gap }}px !important;
  text-align: {{ section.settings.text_alignment }} !important;
  line-height: 1;
}

.guidance-section .main-heading,
#guidance-main-heading-unique {
  font-family: 'Poppins', sans-serif;
  font-size: {{ section.settings.heading_size_desktop }}px !important;
  font-weight: 300;
  margin: 0;
  line-height: 1.3;
  color: #FFFFFF;
  display: block;
  text-transform: capitalize !important;
  letter-spacing: 0.5px;
  text-align: {{ section.settings.text_alignment }} !important;
}

/* Gradient styling moved to snippet */
.features-container {
  position: relative;
  padding: 40px;
  border-radius: 8px;
  background: linear-gradient(
    {{ section.settings.features_bg_angle }}deg,
    {{ section.settings.features_bg_from }} 25%,
    {{ section.settings.features_bg_middle }} 75%,
    {{ section.settings.features_bg_to }} 100%
  );
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border-left: 1px solid rgba(25, 25, 25, 0.8);
  border-right: 1px solid rgba(25, 25, 25, 0.8);
  border-top: none;
  border-bottom: none;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.5), inset 0 0 10px rgba(0, 0, 0, 0.3);
  z-index: 1;
}

.features-container::before,
.features-container::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  height: 1px;
  background: linear-gradient(
    to right,
    transparent 0%,
    #aaa490 25%,
    #ede6ca 50%,
    #aaa490 75%,
    transparent 100%
  );
  opacity: 0.8;
  box-shadow: 0 0 8px #ede6ca;
}

.features-container::before {
  top: 0;
}

.features-container::after {
  bottom: 0;
}

.features-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20px 40px;
}

.features-grid-wrapper {
  display: grid;
  grid-template-columns: 1fr;
  gap: 20px;
}

.feature-group {
  display: contents;
}

.feature-item {
  display: flex;
  align-items: center;
  gap: 12px;
  color: #FFFFFF;
  margin-bottom: 10px;
}

.feature-item span {
  font-size: var(--feature-font-size, 16px);
  font-family: 'Poppins', sans-serif;
  font-weight: 300;
  letter-spacing: 0.2px;
}

.check-icon {
  width: 20px;
  height: 20px;
  min-width: 20px;
  fill: none;
  stroke: {{ section.settings.button_text_gradient_from }};
  stroke-width: 1.5;
  stroke-linecap: round;
  stroke-linejoin: round;
  filter: drop-shadow(0 0 2px rgba(217, 211, 185, 0.3));
}

.feature-icon {
  width: 24px;
  height: 24px;
  min-width: 24px;
  display: flex;
  align-items: center;
  justify-content: center;
}

.feature-icon img {
  width: 100%;
  height: 100%;
  object-fit: contain;
}

.guidance-section .button-container,
#guidance-button-container-unique {
  text-align: {{ section.settings.button_alignment }} !important;
}

.guidance-button {
  display: inline-block;
  padding: 15px 40px;
  font-size: 16px;
  font-weight: 300;
  text-decoration: none;
  border-radius: 6px;
  background: #191919;
  position: relative;
  z-index: 1;
  border: 1px solid #2a2a2a;
  border-top: none;
  border-bottom: none;
  overflow: visible;
  transition: all 0.3s ease;
}

.guidance-button span {
  background: linear-gradient(
    to right,
    {{ section.settings.button_text_gradient_from }} 0%,
    {{ section.settings.button_text_gradient_to }} 80%,
    {{ section.settings.button_text_gradient_from }} 100%
  );
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  display: inline-block;
  position: relative;
  z-index: 1;
  font-weight: 300;
  letter-spacing: 0.5px;
}

.guidance-button::before,
.guidance-button::after {
  content: "";
  position: absolute;
  left: -1px;
  right: -1px;
  height: 1px;
  background: linear-gradient(
    to right,
    #000 0%,
    {{ section.settings.button_text_gradient_from }} 25%,
    {{ section.settings.button_text_gradient_to }} 50%,
    {{ section.settings.button_text_gradient_from }} 75%,
    #000 100%
  );
  opacity: 0;
  transition: opacity 0.3s ease, box-shadow 0.3s ease;
  box-shadow: 0 0 5px rgba(237, 230, 202, 0.5);
}

.guidance-button::before {
  top: 0;
}

.guidance-button::after {
  bottom: 0;
}

.guidance-button:hover {
  border-left: 1px solid #2a2a2a;
  border-right: 1px solid #2a2a2a;
  border-top: none;
  border-bottom: none;
  background-clip: padding-box;
}

.guidance-button:hover::before,
.guidance-button:hover::after {
  opacity: 1;
}

@media screen and (max-width: 768px) {
  .guidance-container {
    grid-template-columns: 1fr;
    gap: 40px;
    align-items: {% if section.settings.text_vertical_alignment == 'top' %}start{% elsif section.settings.text_vertical_alignment == 'bottom' %}end{% else %}center{% endif %};
  }
  
  .features-container {
    padding: 30px 20px;
  }
  
  .features-grid-wrapper {
    gap: 0;
  }
  
  .features-grid {
    grid-template-columns: 1fr;
    gap: 15px;
  }
  
  .guidance-section .main-heading,
  #guidance-main-heading-unique {
    font-size: {{ section.settings.heading_size_mobile }}px !important;
    text-align: {{ section.settings.text_alignment_mobile | default: 'center' }} !important;
  }
  
  .guidance-section .guidance-heading,
  #guidance-heading-unique {
    margin-bottom: {{ section.settings.text_button_gap }}px !important;
    text-align: {{ section.settings.text_alignment_mobile | default: 'center' }} !important;
  }

  .text-side {
    text-align: {{ section.settings.text_alignment_mobile | default: 'center' }} !important;
  }

  .guidance-section .button-container,
  #guidance-button-container-unique {
    text-align: {{ section.settings.button_alignment_mobile | default: 'center' }} !important;
  }

  .feature-item span {
    font-size: var(--feature-font-size-mobile, 14px);
  }
}
</style>

<div class="guidance-section">
  <div class="guidance-container">
    <div class="text-side">
      <div class="guidance-heading" id="guidance-heading-unique">
        <h2 class="main-heading" id="guidance-main-heading-unique">
          {% render 'gradient-word-maker', 
            text: section.settings.heading_text,
            start_color: section.settings.subheading_gradient_from,
            end_color: section.settings.subheading_gradient_to
          %}
        </h2>
      </div>

      {% if section.settings.button_text != blank %}
        <div class="button-container" id="guidance-button-container-unique">
          <a href="{{ section.settings.button_url }}" class="guidance-button">
            <span>{{ section.settings.button_text }}</span>
          </a>
        </div>
      {% endif %}
    </div>

    <div class="features-container">
      <div class="features-grid-wrapper">
        <div class="features-grid">
          {% for block in section.blocks limit: 4 %}
            {% if block.type == "feature" %}
              <div class="feature-item" style="--feature-font-size: {{ block.settings.font_size_desktop }}px; --feature-font-size-mobile: {{ block.settings.font_size_mobile }}px;">
                {% if block.settings.icon %}
                  <div class="feature-icon">
                    <img src="{{ block.settings.icon | image_url: width: 24 }}" width="24" height="24" alt="{{ block.settings.text }}" loading="lazy">
                  </div>
                {% else %}
                  <svg class="check-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
                    <path d="M9 12l2 2l4-4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% endif %}
                <span style="background: linear-gradient(to right, {{ block.settings.text_gradient_from }}, {{ block.settings.text_gradient_to }}); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
        <div class="features-grid">
          {% for block in section.blocks offset:4 %}
            {% if block.type == "feature" %}
              <div class="feature-item" style="--feature-font-size: {{ block.settings.font_size_desktop }}px; --feature-font-size-mobile: {{ block.settings.font_size_mobile }}px;">
                {% if block.settings.icon %}
                  <div class="feature-icon">
                    <img src="{{ block.settings.icon | image_url: width: 24 }}" width="24" height="24" alt="{{ block.settings.text }}" loading="lazy">
                  </div>
                {% else %}
                  <svg class="check-icon" viewBox="0 0 24 24">
                    <circle cx="12" cy="12" r="10" stroke-width="1.5"/>
                    <path d="M9 12l2 2l4-4" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                {% endif %}
                <span style="background: linear-gradient(to right, {{ block.settings.text_gradient_from }}, {{ block.settings.text_gradient_to }}); -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;">{{ block.settings.text }}</span>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</div>
